testenv = localhost

#Backend URLs
BE_GD_CKAN_DATASET_URL=http://$testenv/ckan/dataset
be_typo3_url=https://$testenv:3080
be_index_app2_url=http://$testenv:9070/index-application2
be_gd_data_url=http://$testenv:9070/govdata-data
be_gd_db_url=http://$testenv:9070/govdata-db

# SEARCHMAP
BE_GD_DATA_SEARCHMAP_TILE_URL=
BE_GD_DATA_MAP_PREVIEW_TILE_URL=
BE_GD_DATA_SEARCHMAP_GEOSEARCH_URL=
BE_GD_DATA_SEARCHMAP_OSMSEARCH_URL=https://nominatim.openstreetmap.org/search?limit=5&format=json&q=
BE_GD_DATA_USE_OSM=true

BE_GD_AUTH_USER=
BE_GD_AUTH_PASSWORD=

GD_SPARQL_DS=
GD_SPARQL_MQA=

# Footer Social Media Links
mastodon_url=
linkedin_url=
gitlab_url=

# features
show_user_survey_header=true
user_survey_link=https://fitko.lamapoll.de/Nutzendenbefragung-GOVDATA
footer_logo_link=
footer_logo_link_alt=
disabled_elasticsearch_filter_types=blog

# MAIL CONFIG
# if disabled, no contactform will be shown and api/contact will be disabled
mail_enabled=true
mail_smtp_host=
mail_smtp_port=25
mail_smtp_user=
mail_smtp_password=
mail_smtp_tls_enable=false
mail_smtp_from_address=
mail_smtp_to_address=
mail_datamanagement=

# matomo
matomo_tracker_url =
matomo_site_id =
matomo_options=

data_management_active = 1
metadata_guide_link=https://www.bva.bund.de/SharedDocs/Downloads/DE/Behoerden/Beratung/Methoden/open_data_leitfaden_metadaten.html
metadata_dcatap_link="https://www.dcat-ap.de/def/dcatde/2.0/spec/#klasse-datensatz"
metadata_quality_dashboard_active = 1

# extra csp header in array format
csp_extra_script_src=["'unsafe-eval'", "$matomo_tracker_url"]
csp_extra_img_src=["https://sgx.geodatenzentrum.de/", "https://tile.openstreetmap.org", "$be_typo3_url", "$matomo_tracker_url"]
csp_extra_connect_src=["https://www.govdata.de/", "$matomo_tracker_url", "https://$testenv/sparql", "https://sgx.geodatenzentrum.de/"]
# Used by basemap vector tile service
csp_extra_font_src=["https://cdn.jsdelivr.net"]
csp_extra_style_src=["https://cdn.jsdelivr.net"]

log_level=debug

# keycloak
keycloak_issuer=https://$testenv:3060/realms/govdata-datenpflege
keycloak_client_id=template-engine
keycloak_client_secret=
// 32 char long pw for iron-session
session_secret=


#redis
redis_host=$testenv
redis_port=6379
redis_db=0
